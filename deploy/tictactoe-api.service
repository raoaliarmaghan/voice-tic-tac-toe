# systemd unit for the game's token API on the portfolio server.
# Install:  sudo cp deploy/tictactoe-api.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now tictactoe-api
[Unit]
Description=Voice Tic-Tac-Toe API (aliarmaghan.com/tic-tac-toe)
After=network.target

[Service]
User=ali
WorkingDirectory=/home/ali/voice-tic-tac-toe/backend
# --proxy-headers: behind nginx, take the visitor IP from X-Forwarded-For so the
# per-IP token rate limit applies per visitor, not to everyone at once.
ExecStart=/home/ali/voice-tic-tac-toe/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8020 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
